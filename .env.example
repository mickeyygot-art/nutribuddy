# Copy this to .env for local development (never commit .env to GitHub)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_SERVICE_ROLE_key_here   # Project Settings → API → service_role (not anon)
CRON_SECRET=your_random_secret_string_here          # Any random string, e.g. output of: openssl rand -hex 32
ADMIN_SECRET=your_admin_password_here               # Protects /admin — set in Railway env vars
POSTHOG_API_KEY=phc_xxxxxxx                          # PostHog project API key (YOL-45 analytics)
# POSTHOG_HOST=https://us.i.posthog.com              # Optional — EU: https://eu.i.posthog.com
# POSTHOG_DISABLED=true                              # Optional — suppress all analytics (local dev)
# POSTHOG_INTERNAL_IDS=Uxxxx,Uyyyy                   # Optional — comma-separated LINE IDs to exclude
LIFF_ID=2010250361-xxxxxxxx                          # LIFF app ID (YOL-50 in-LINE dashboard)
